# Copia este archivo como .env y rellena tus credenciales.
# El archivo .env está en .gitignore y nunca se sube al repositorio.

# Semantic Scholar API key (opcional)
SEMANTIC_SCHOLAR_API_KEY=

# CrossRef polite pool email (recomendado)
CROSSREF_EMAIL=your@email.com

# OpenAlex polite pool email (recomendado)
OPENALEX_EMAIL=your@email.com

# NCBI/PubMed API key (opcional)
NCBI_API_KEY=

# CORE (core.ac.uk) API key (obtener en https://core.ac.uk/services/api)
CORE_API_KEY=
